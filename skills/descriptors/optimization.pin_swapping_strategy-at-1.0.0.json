{
  "$schema": "https://spec.example.com/skill-descriptor-v3.json",
  "specVersion": "3.0",
  "id": "optimization.pin_swapping_strategy@1.0.0",
  "displayName": "Pin Swapping Optimization",
  "description": "Swap LUT input pins to remap critical signals to faster pins (A5/A6). MUTATING. Side effects: cell pin connections changed, checkpoint written. Trigger: WNS stuck around -0.3ns, LUT input pins have delay variation. Requires critical_paths JSON input.",
  "idempotency": "non-idempotent",
  "sideEffects": [
    "pin_connections",
    "checkpoint_file"
  ],
  "timeout": {
    "defaultMs": 120000,
    "maxMs": 240000
  },
  "authentication": {
    "type": "none"
  },
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "critical_paths": {
        "type": "array",
        "description": "List of path descriptors with cells/pins info"
      },
      "temp_dir": {
        "type": "string",
        "description": "Directory for checkpoint",
        "default": "temp",
        "minLength": 1
      },
      "checkpoint_prefix": {
        "type": "string",
        "description": "Checkpoint filename prefix",
        "default": "pin_swap",
        "minLength": 1
      }
    },
    "required": [
      "critical_paths"
    ]
  },
  "returns": {
    "type": "object",
    "additionalProperties": false
  },
  "errors": [
    {
      "code": "INVALID_PARAMETER",
      "recoverable": false
    },
    {
      "code": "RESOURCE_NOT_FOUND",
      "recoverable": false
    },
    {
      "code": "TEMPORARILY_UNAVAILABLE",
      "recoverable": true
    },
    {
      "code": "SKILL_TIMEOUT",
      "recoverable": true
    }
  ]
}